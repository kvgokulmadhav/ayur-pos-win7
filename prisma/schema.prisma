generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  name      String
  role      String   // "ADMIN", "MANAGER", "STAFF"
  pin       String   @default("1234") // Quick 4-digit counter PIN
  phone     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model StoreProfile {
  id            String   @id // "kottakkal" or "secondary"
  entityType    String   // "KOTTAKKAL" or "SECONDARY"
  storeName     String
  dealerCode    String?  // e.g. "AVS-DL-7492"
  dlNumber      String?  // Drug License No.
  fssaiNumber   String?  // FSSAI No.
  phone         String
  upiId         String?
  address       String
  invoicePrefix String   // e.g. "KAVS-" or "AGN-"
  receiptFooter String?  // e.g. "Official Kottakkal Arya Vaidya Sala Dealer • Thank You"
  updatedAt     DateTime @updatedAt
}

model Distributor {
  id              String   @id @default(cuid())
  name            String   @unique // e.g. "Kottakkal Central Depot", "Nagarjuna Agency", "Vaidyaratnam"
  distributorType String   @default("THIRD_PARTY") // "KOTTAKKAL_DEPOT" or "THIRD_PARTY"
  contactPerson   String?
  phone           String?
  email           String?
  address         String?
  dlNumber        String?
  gstin           String?
  notes           String?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  products        Product[]
  inwardPurchases InwardPurchase[]
}

model Product {
  id            String               @id @default(cuid())
  productCode   String?              // SKU Code e.g. "FGA001"
  name          String               // e.g. "Dasamoolarishtam 450ml"
  sanskritName  String?              // Sanskrit / Malayalam classical name
  manufacturer  String               @default("Kottakkal Arya Vaidya Sala") // Standardized Manufacturer
  brand         String               // Backward compatibility alias
  isKottakkal   Boolean              @default(true) // Crucial for auto split-billing
  category      String               // Product Category
  unitType      String               @default("BOTTLE") // BOTTLE, BOX, JAR, STRIP, PACKET
  packSize      String               @default("450 ml") // 450 ml, 200 ml, 500 g, 100 Tab
  packQuantity  Int                  @default(1) // e.g. 100 for 100 Tab, 450 for 450 ml
  stripsPerBox  Int?                 // strips received in one box
  unitsPerStrip Int?                 // tablets or units in one strip
  looseUnit     String?              // "ml", "g", "Tab", "Cap"
  allowLoose    Boolean              @default(true)
  loosePrice    Float?               // Official Kottakkal Loose MRP per unit
  unitPrice     Float                // Retail MRP (in INR)
  purchaseRate  Float                // Dealer purchase cost
  stock         Float                @default(0) // Supports fractional stock for loose dispensing
  reorderLevel  Int                  @default(10)
  reorderQty    Int                  @default(24)
  rackLocation  String?              // Shelf/Rack e.g. "Rack A-1"
  barcode       String?
  indications   String?              // Brief Ayurvedic indication
  active        Boolean              @default(true)
  distributorId String?
  distributor   Distributor?         @relation(fields: [distributorId], references: [id])
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  batches       Batch[]
  invoiceItems  InvoiceItem[]
  indentItems   PurchaseIndentItem[]
  inwardItems   InwardItem[]
}

model Batch {
  id           String        @id @default(cuid())
  productId    String
  product      Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  batchNumber  String
  expiryDate   DateTime
  mrp          Float
  purchaseRate Float
  currentStock Float         @default(0)
  rackLocation String?
  supplierName String?       // Distributor name
  createdAt    DateTime      @default(now())

  invoiceItems InvoiceItem[]
}

model SalesSession {
  id                String    @id @default(cuid())
  sessionNumber     String    @unique // e.g. "SALE-2026-0001"
  checkoutKey       String?   @unique
  checkoutHash      String?
  customerName      String    @default("Counter Customer")
  customerPhone     String?
  prescribingDoctor String?
  paymentMode       String    @default("CASH") // "CASH", "UPI", "CARD", "KHATA"
  totalCollected    Float
  hasKottakkal      Boolean   @default(false)
  hasSecondary      Boolean   @default(false)
  notes             String?
  billedBy          String?   // Username / Cashier name
  createdAt         DateTime  @default(now())

  invoices          Invoice[]
}

model Invoice {
  id              String        @id @default(cuid())
  invoiceNumber   String        @unique // e.g. "KAVS-01001" or "AGN-00201"
  sessionId       String
  session         SalesSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  billingEntity   String        // "KOTTAKKAL" or "SECONDARY"
  entityStoreName String
  subtotal        Float
  discount        Float         @default(0)
  totalAmount     Float
  paymentMode     String        @default("CASH")
  status          String        @default("PAID") // "PAID", "CREDIT"
  isEdited        Boolean       @default(false)
  editedAt        DateTime?
  editedBy        String?
  createdAt       DateTime      @default(now())

  items           InvoiceItem[]
}

model InvoiceItem {
  id           String   @id @default(cuid())
  invoiceId    String
  invoice      Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId    String
  product      Product  @relation(fields: [productId], references: [id])
  productCode  String?  // Product SKU Code
  productName  String
  manufacturer String?  // Standardized manufacturer
  brandName    String
  batchId      String?
  batch        Batch?   @relation(fields: [batchId], references: [id])
  batchNumber  String?
  quantity     Float    // Supports loose counts e.g. 10 tabs or 250 ml
  stockQuantity Float?  // Pack equivalents at sale time, retained for accurate reversal
  dispenseMode String   @default("PACK") // "PACK" or "LOOSE"
  unitLabel    String?  // e.g. "Bottle", "Tabs", "ml"
  unitPrice    Float    // Applied unit MRP (per pack or per loose unit)
  totalPrice   Float
  createdAt    DateTime @default(now())
}

model InwardPurchase {
  indentId      String?
  id            String       @id @default(cuid())
  invoiceNumber String       // Supplier / Depot DC Invoice Number
  supplierName  String       // e.g. "Kottakkal Central Depot" or "Nagarjuna Distributor"
  distributorId String?
  distributor   Distributor? @relation(fields: [distributorId], references: [id])
  targetEntity  String       // "KOTTAKKAL" or "SECONDARY"
  invoiceDate   DateTime     @default(now())
  totalAmount   Float        @default(0)
  notes         String?
  receivedBy    String?      // Staff/Manager who logged stock
  createdAt     DateTime     @default(now())

  items         InwardItem[]
}

model InwardItem {
  id           String         @id @default(cuid())
  purchaseId   String
  purchase     InwardPurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId    String
  product      Product        @relation(fields: [productId], references: [id])
  batchNumber  String
  expiryDate   DateTime
  quantity     Float
  freeQuantity Float          @default(0)
  purchaseRate Float
  mrp          Float
  rackLocation String?
  createdAt    DateTime       @default(now())
}

model PurchaseIndent {
  id           String               @id @default(cuid())
  indentNumber String               @unique // e.g. "IND-KAVS-2026-001"
  targetEntity String               // "KOTTAKKAL_DEPOT" or "OTHER_AGENCIES"
  supplierName String               // "Kottakkal Arya Vaidya Sala Central Depot"
  priority     String               @default("NORMAL") // "NORMAL", "URGENT"
  status       String               @default("PENDING") // "PENDING", "SENT_TO_DEPOT", "RECEIVED"
  notes        String?
  raisedBy     String?              // "Auto-Reorder Engine" or Cashier Name
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  items        PurchaseIndentItem[]
}

model PurchaseIndentItem {
  id                String         @id @default(cuid())
  indentId          String
  indent            PurchaseIndent @relation(fields: [indentId], references: [id], onDelete: Cascade)
  productId         String
  product           Product        @relation(fields: [productId], references: [id])
  requestedQty      Int
  estimatedUnitRate Float?
  reason            String?
}

model Customer {
  id                String                @id @default(cuid())
  name              String
  phone             String                @unique
  address           String?
  totalCredit       Float                 @default(0)
  amountPaid        Float                 @default(0)
  balanceDue        Float                 @default(0)
  notes             String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  transactions      CustomerTransaction[]
}

model CustomerTransaction {
  id          String   @id @default(cuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type        String   // "INVOICE_CREDIT" or "PAYMENT_RECEIVED"
  amount      Float
  paymentMode String?  // "CASH", "UPI", "CARD"
  reference   String?  // Invoice number or Payment Receipt No
  notes       String?
  createdAt   DateTime @default(now())
}

model CustomerLedger {
  id                String   @id @default(cuid())
  customerName      String
  customerPhone     String   @unique
  totalCredit       Float    @default(0)
  amountPaid        Float    @default(0)
  balanceDue        Float    @default(0)
  lastTransactionAt DateTime @default(now())
  notes             String?
}

model BackupSetting {
  id                String    @id @default("backup-setting")
  localPath         String    @default("D:\\AyurPOS_Backups")
  penDrivePath      String    @default("E:\\AyurPOS_Backups")
  autoBackupOnClose Boolean   @default(true)
  lastBackupAt      DateTime?
  lastBackupStatus  String?
  lastBackupDetails String?
}

model BackupLog {
  id          String   @id @default(cuid())
  timestamp   DateTime @default(now())
  backupType  String   // "MANUAL", "PEN_DRIVE", "DAY_CLOSE"
  filename    String
  fileSizeKb  Int
  destination String
  status      String   // "SUCCESS", "FAILED"
  details     String?
}

model AuditLog {
  id         String   @id @default(cuid())
  timestamp  DateTime @default(now())
  userName   String
  userRole   String   // "ADMIN", "STAFF"
  action     String   // "INVOICE_CREATE", "INVOICE_EDIT", "STOCK_ADJUSTMENT", "PRODUCT_CREATE", "USER_LOGIN"
  entityType String   // "INVOICE", "PRODUCT", "BATCH", "CUSTOMER", "USER"
  entityId   String?  // Invoice No, Product ID, etc.
  details    String   // Human-readable summary of what changed
  metadata   String?  // JSON string of before/after state
}

model AuthSession {
  tokenHash String @id
  userId String
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([userId])
}

model StockAuditSession {
  id                  String           @id @default(cuid())
  sessionNumber       String           @unique // e.g. "AUDIT-2026-0001" or "MIGRATE-2026-0001"
  auditType           String           // "INITIAL_MIGRATION", "PERIODIC_AUDIT", "RACK_AUDIT", "CATEGORY_AUDIT"
  scope               String           @default("ALL") // "ALL", "RACK", "CATEGORY", "CUSTOM"
  scopeValue          String?          // e.g. "Rack A-1" or "Arishtam"
  status              String           @default("COMPLETED") // "DRAFT", "COMPLETED"
  totalItems          Int              @default(0)
  totalDiscrepancy    Float            @default(0) // Net units variance (+ or -)
  totalVarianceValue  Float            @default(0) // Net ₹ value discrepancy (+ or -)
  totalShrinkageValue Float            @default(0) // Total loss ₹ from deficits
  totalSurplusValue   Float            @default(0) // Total gain ₹ from surpluses
  notes               String?
  performedBy         String           // Username
  appliedAt           DateTime         @default(now())
  createdAt           DateTime         @default(now())

  items               StockAuditItem[]
}

model StockAuditItem {
  id              String            @id @default(cuid())
  auditSessionId  String
  auditSession    StockAuditSession @relation(fields: [auditSessionId], references: [id], onDelete: Cascade)
  productId       String
  productCode     String?
  productName     String
  packSize        String?
  batchId         String?
  batchNumber     String
  expiryDate      DateTime?
  mrp             Float
  purchaseRate    Float
  rackLocation    String?
  systemStock     Float             // Stock recorded in system prior to audit
  physicalStock   Float             // Actual counted stock
  variance        Float             // physicalStock - systemStock
  varianceValue   Float             // variance * purchaseRate
  status          String            @default("MATCHED") // "MATCHED", "SHORTAGE", "EXCESS", "NEW_BATCH"
  notes           String?
  createdAt       DateTime          @default(now())
}

